{
  "name": "fill-my-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "PATH=\"$PWD/tools/native:$PATH\" expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ios:ui": "tools/ios-ui-tests/run.sh",
    "check:lines": "node scripts/check-lines.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:assets": "node scripts/check-app-assets.mjs",
    "map:build": "node tools/map-pack/build.mjs",
    "map:build:v2": "node tools/map-pack/build-v2.mjs",
    "map:fetch": "node tools/map-pack/fetch-release-v2.mjs",
    "map:verify": "node tools/map-pack/fetch-release-v2.mjs && node tools/map-pack/verify-v2.mjs",
    "verify": "pnpm check:lines && pnpm check:privacy && pnpm check:assets && pnpm lint && pnpm typecheck && pnpm test:run && pnpm map:verify"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.3.7",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-sharing": "~57.0.16",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-view-shot": "5.1.0",
    "react-native-zip-archive": "^9.4.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
